# Copy to .env and replace every password placeholder before running.
# Never commit .env, credentials, API keys, or user data.
PHD_PLATFORM_DB_BACKEND=sqlite
PHD_PLATFORM_MYSQL_HOST=127.0.0.1
PHD_PLATFORM_MYSQL_PORT=3306
PHD_PLATFORM_MYSQL_DATABASE=phd_workspace
PHD_PLATFORM_MYSQL_USER=phd_app
PHD_PLATFORM_MYSQL_PASSWORD=
PHD_PLATFORM_SEED_HTML=

# Define your own accounts. Placeholder passwords are rejected at startup.
PHD_PLATFORM_ACCOUNTS='{"Applicant":"REPLACE_WITH_YOUR_PASSWORD","Collaborator":"REPLACE_WITH_YOUR_PASSWORD","Reviewer":"REPLACE_WITH_YOUR_PASSWORD"}'
PHD_PLATFORM_ENV=local
PHD_PLATFORM_COOKIE_SECURE=0
PHD_PLATFORM_AI_API_KEY=
PHD_PLATFORM_AI_KEY_ENV_ONLY=1
